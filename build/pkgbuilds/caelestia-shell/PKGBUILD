# Larch carries this recipe: the AUR's caelestia-shell @ d2c7b31 (AUR package
# sources, 0BSD) with one change, the one install_caelestia_shell_stable_quickshell
# in larch-rice makes and measured: Arch's quickshell 0.3.1 instead of
# quickshell-git, which conflicts with the quickshell Larch's desktop runs on.
# Built from the unchanged recipe, [larch]'s caelestia-shell could not be
# installed beside it ("would replace something you have": hyprarch-conf,
# nespolibt, rel2c sweep pass 3, 2026-09-29), and its repository answer kept the
# fetch from reaching that compatibility build. pkgrel 1.1 supersedes that 2.5.0-1.
# caelestia-shell

# Maintainer: Soramane <soramane32 at gmail dot com>

pkgname='caelestia-shell'
pkgver=2.5.0
pkgrel=1.1
pkgdesc='The desktop shell for the Caelestia dotfiles'
arch=('x86_64' 'aarch64')
url='https://github.com/caelestia-dots/shell'
license=('GPL-3.0-only')
depends=(
    'caelestia-cli'
    'quickshell'
    'glibc'
    'gcc-libs'

    # Brightness
    'ddcutil'
    'brightnessctl'

    # Services
    'libcava'
    'networkmanager'
    'lm_sensors'
    'aubio'
    'libpipewire'
    'libqalculate'
    'power-profiles-daemon'

    # Fonts
    'ttf-material-symbols-variable'
    'ttf-rubik-vf'
    'ttf-cascadia-code-nerd'

    # Qt modules
    'qt6-base'
    'qt6-declarative'
    'qt6-imageformats'
    'qt6-m3shapes-git'

    # Extra functionality
    'swappy'
    'fish'
    'bash'
)
optdepends=(
    'asdbctl: controlling the brightness of Apple Studio Displays'
    'fprintd: fingerprint unlock for the lock screen'
    'howdy-next: face unlock for the lock screen'
)
makedepends=('cmake' 'ninja' 'qt6-shadertools')
provides=($pkgname)
conflicts=($pkgname-git)
_pkg="${pkgname}-v${pkgver}"
source=("${url}/releases/download/v${pkgver}/${_pkg}.tar.gz")
sha256sums=('6bef9feff9f9c6afeb6fdf0b9bb1cfc3cfd7dff4c2a020e8079d6720975f3b6a')

build() {
    cd "${srcdir}/${_pkg}"

    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_INSTALL_PREFIX=/ \
        -DVERSION=$pkgver \
        -DGIT_REVISION="$(cat REVISION)" \
        -DDISTRIBUTOR="AUR (package: ${pkgname})"
    cmake --build build
}

package() {
    cd "${srcdir}/${_pkg}"

    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}
