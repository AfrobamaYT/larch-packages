# Larch: the AUR recipe (c5cf1fd 2026-05-17) built whatever the default branch held;
# pinned here to Aylur/astal cbcd9f49 (2026-09-23), reviewed 2026-09-30. Nothing else changed.
# Maintainer: kotontrion <kotontrion@tutanota.de>

pkgname=quarrel-git
_pkgname=quarrel
pkgver=r986.cbcd9f4
pkgrel=1
provides=(quarrel libquarrel.so=0-64)
pkgdesc="Lib for command line argument parsing."
arch=(x86_64)
license=(LGPL-2.1-only)
url="https://github.com/Aylur/astal"
depends=(
  glib2
  glibc
)
makedepends=(
  meson
  git
  gobject-introspection
  vala
)
source=("git+${url}.git#commit=cbcd9f49dd6b9638dc5623b56cc6e1e0a60b593e")
sha256sums=('SKIP')

pkgver() {
  cd astal
  #git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd astal/lib/$_pkgname
  arch-meson build
  meson compile -C build
}

package() {
  cd astal/lib/$_pkgname
  meson install -C build --destdir "$pkgdir"
}

