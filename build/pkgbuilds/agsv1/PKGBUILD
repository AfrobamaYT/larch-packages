# agsv1
#
# Larch carries this recipe: kotontrion/PKGBUILDS @ 580117dda5afc613987a559bb0181a16a9dc747a
# agsv1/ (0BSD, the maintainer's own; agsv1 was never published in the AUR:
# AUR comment 998455 on aylurs-gtk-shell, agsv1/.noaur). AGS v1.9.0 installed as
# `agsv1` beside modern AGS, for rices written for v1 (aworldc). Changes, per
# the review of 2026-09-30 (build/reviews/agsv1-1.9.0.md):
#  - libgnome-volume-control pinned to 0a4eda0c with a checksum; it cloned the
#    moving default branch (SKIP). Taken from GNOME's GitHub mirror, which
#    yields the same checksum. Public headers and meson options equal AGS
#    v1.9.0's own submodule pin, 8e7a5a4c.
#  - `npm ci --ignore-scripts` against the tarball's package-lock.json (all
#    entries sha512-pinned, none with install scripts) in prepare(), instead of
#    `npm install` in build(), which neither enforces the lock nor stays quiet.
#  - The lockfile's TypeScript 5.3.3 first on PATH; Arch's typescript 6
#    deprecates moduleResolution=node10 and baseUrl, both set in tsconfig.json.
#  - -Dbuild_types=false: the 61.6 MB editor type tree is not shipped; nothing
#    reads it at runtime.
#  - license: upstream GPL-3.0-or-later, GPL-2.0-or-later for the bundled libgvc.

# Maintainer: kotontrion <kotontrion@tutanota.de>

pkgname=agsv1
_pkgname=ags
pkgver=1.9.0
pkgrel=3.1
pkgdesc="Aylurs's Gtk Shell (AGS), An eww inspired gtk widget system."
arch=('x86_64')
url="https://github.com/Aylur/ags"
license=('GPL-3.0-or-later' 'GPL-2.0-or-later')
makedepends=('git' 'gobject-introspection' 'meson' 'glib2-devel' 'npm')
depends=('gjs' 'glib2' 'glibc' 'gtk3' 'gtk-layer-shell' 'libpulse' 'pam')
optdepends=('gnome-bluetooth-3.0: required for bluetooth service'
            'greetd: required for greetd service'
            'libdbusmenu-gtk3: required for systemtray service'
            'libsoup3: required for the Utils.fetch feature'
            'libnotify: required for sending notifications'
            'networkmanager: required for network service'
            'power-profiles-daemon: required for powerprofiles service'
            'upower: required for battery service')
backup=('etc/pam.d/ags')
_gvc_commit=0a4eda0cdc2deb352bebc70ec697c42af46094e4
source=("$pkgname-$pkgver.tar.gz::https://github.com/Aylur/ags/archive/refs/tags/v${pkgver}.tar.gz"
        "libgnome-volume-control::git+https://github.com/GNOME/libgnome-volume-control.git#commit=${_gvc_commit}"
        "fix-type-error.patch"
        "fix-gir-error.patch")
sha256sums=('962f99dcf202eef30e978d1daedc7cdf213e07a3b52413c1fb7b54abc7bd08e6'
            '3372701c72b4d87e67f886c8ff6b66d0e7d32f18951ae910e2afbd806abf47be'
            '784bf72809db1d446c3e0989d673ad59e5a6e1e70b7d6d221567154db050ceb5'
            'e1a9a4cb487d416b82fe9040a814850d6cdc61d4c6f07548ee4f1e543f4422c1')

prepare() {
  cd "$srcdir/$_pkgname-$pkgver"
  mv -Tf "$srcdir"/libgnome-volume-control subprojects/gvc
  patch -Np1 -i ../fix-type-error.patch
  patch -Np1 -i ../fix-gir-error.patch
  npm ci --ignore-scripts --no-audit --no-fund --no-update-notifier \
    --cache "$srcdir/npm-cache"
}

build() {
  cd "$srcdir/$_pkgname-$pkgver"
  export PATH="$PWD/node_modules/.bin:$PATH"
  arch-meson build --libdir "lib/$_pkgname" -Dbuild_types=false
  meson compile -C build
}

package() {
  cd "$srcdir/$_pkgname-$pkgver"
  meson install -C build --destdir "$pkgdir"
  rm "${pkgdir}"/usr/bin/ags
  ln -sf /usr/share/com.github.Aylur.ags/com.github.Aylur.ags "${pkgdir}"/usr/bin/agsv1
}
