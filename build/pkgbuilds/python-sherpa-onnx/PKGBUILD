# Maintainer of the AUR recipe this follows (sherpa-onnx, 2fbfea7): devome <evinedeng@hotmail.com>
#
# Larch carries the Python bindings alone, for the assistant's English voice
# (Kokoro, cmd/larch-assistant). Built against Arch's onnxruntime; without the
# microphone (portaudio), websocket, C API and command-line parts, so their
# sources and cargs are gone, and without the sherpa-onnx-cli command, which
# needs click. Nothing is downloaded while building: the
# sources below are all it gets, and a download it tries anyway fails.
# build/reviews/python-sherpa-onnx-1.13.8.md has the rest.

pkgname=python-sherpa-onnx
_pkgbase=sherpa-onnx
pkgver=1.13.8
pkgrel=1
pkgdesc="Offline speech recognition and synthesis with next-gen Kaldi and onnxruntime (Python bindings)"
arch=('x86_64')
url="https://github.com/k2-fsa/sherpa-onnx"
# espeak-ng, compiled in for phonemes, is GPL-3.0-or-later; the rest is
# Apache-2.0 and what it bundles: nlohmann/json and piper-phonemize MIT,
# hclust-cpp BSD-2-Clause, kissfft BSD-3-Clause, Eigen MPL-2.0.
license=('Apache-2.0' 'GPL-3.0-or-later' 'MIT' 'BSD-2-Clause' 'BSD-3-Clause' 'MPL-2.0')
depends=('gcc-libs' 'glibc' 'onnxruntime' 'python')
optdepends=('python-sentencepiece: keyword and hotword tokens'
            'pypinyin: Chinese keyword and hotword tokens')
makedepends=('cmake' 'ninja' 'pybind11' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("${_pkgbase}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
        "eigen-5.0.1.tar.gz::https://gitlab.com/libeigen/eigen/-/archive/5.0.1/eigen-5.0.1.tar.gz"
