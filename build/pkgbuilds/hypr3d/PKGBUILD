# Hypr3D, a Hyprland plugin that turns the session into a walkable 3D room
# (samine825/Hypr3D, MIT), from Larch's fork AfrobamaYT/Hypr3D, branch
# larch/main: upstream d0be2e0 plus three fixes, each measured red then green
# in the dev VM -- built with -fno-gnu-unique, so an unloaded plugin can be
# loaded again without crashing Hyprland (7069d1e); new windows side by side
# on an arc instead of one in front of the other (1bfdbd3); its pass element
# taken out of Hyprland's render pass on unload, which crashed Hyprland when
# the room was shown (d681e3b); since then scene models read, decoded and
# cooked into Jolt shapes on worker threads, which took a 47 MB model's
# 391 + 466 ms freeze of the whole desktop down to 53-67 ms (bb4277a,
# 6d040e3, 46e28a4); the aim ray by a slab test, 995 -> 1.3 us (54e1cb5);
# embedded JPEG textures through libjpeg-turbo, which were black (3656ac7);
# one room across every monitor -- each monitor its own off-axis window of
# one view plane, the desktop's windows a wall where they stood (b04b8ba,
# e078c40, world.span, default on); layer surfaces on a monitor away from
# the layout's origin, which came out blank (a4849b7); leaving the room keeps
# it as it was -- where you stood and looked, the view and every window's
# place -- where entering started over at the default view with every window
# laid out afresh (371300b; hl.plugin.hypr3d.reset() starts over); a second
# avatar, the companion, that hl.plugin.hypr3d.companion() walks to the
# player, the spawn or a window and turns to face one, with its events on
# socket2 -- the room side of the AI teammate, steered by
# larch-room-bridge; it appears only once something calls it (9f3fc76,
# 8c1c758); a focus lock that keeps the keyboard on a window, F6 (ee97ab1);
# movement with weight -- Quake's ground friction and acceleration, a jump
# with coyote time and a buffer, Space twice to fly, world.gravity (8e070c6);
# the companion's eye, companion("see"), one picture of the room as a JPEG
# beside Hyprland's sockets and a sight event (971cbc7); windows that write
# no depth, so a lone window coplanar with a rice's screen-sized layer stays
# visible (295a5ff); mipmaps, anisotropic filtering and a -0.5 LOD bias for
# window snapshots, so text stays legible from afar (860c2f3); a locked
# session closes the room and keeps it closed -- it drew every window over
# the lock screen (4913b46); F2 brings the aimed window to the eye at 1:1
# and back (9e3ae98, 90a21d9); the scene reaches the screen pixel for pixel
# -- the composite flipped v in 16-bit floats and smeared every horizontal
# edge (c3e6d81); F4, the cinema: the window as big as the view, the room
# dark around it (61bda92); portals, a picture in the room that starts its
# command when walked into (e9e2b4a); F1 runs the room's menu and brings
# its window to the eye (6d9ea79); the monitor wall sized to end above the
# feet, so a wall of several monitors no longer reaches under the floor
# (87c14c2); a waste bin that closes a window let go on it (67c60f2); a game
# holding the mouse no longer spins the room (fd1fa6d); the menu follows the
# player (75c04a0); soft shadows under windows (7df5ba3); drawing only while
# something changes, 0 frames in a still room instead of 552 per 10 s
# (a31fa6c); the rice's bar and notifications as a HUD over the view
# (278a577); F7, the process gun -- shoot a window to close it, hold to kill
# a hung one (a5e87e5); floating windows keep their size (cb996e0); objects
# and pictures put into the room at runtime (fb17cff); head tracking from
# opentrack, off by default (ddf5d6a); a TV zone a window is put on, scaled
# there with Super+wheel, and F8 to use any window with the mouse (299bd37);
# materials with only a colour drawn in it instead of black (99cea05); the
# view stays on the monitor the room was opened from -- aiming at a window
# laid out on another monitor moved the whole view there (31512ed); Super+F
# brings a window laid out on another monitor to the one in front for its
# fullscreen, and back after (af03c29); leaving the room hands tiles back
# to the layout the way Hyprland's settiled does, and windows opened in
# the room come back as tiles -- tiles overlapped and windows turned
# floating (82ed203); Super+F in the room is a screen in front of the
# player with the room around it, used like a monitor -- mouse and keys
# on the window -- and a key's release goes where its press went, which
# had opened caelestia's launcher over it (c1f3ec4); the room's look after
# the owner's approved Claude Design drafts -- a crosshair whose shape says
# what it points at with a label of its name and keys, Larch's pointer on a
# window in use, F3 as a panel, the bin's crumpled paper ball and its note
# (19bb9a6, 4fad617, 182a229, 8867914, d2b744a), F2, Super+F and the F1
# menu on the drafts' curves with the room dimmed and, behind the menu,
# blurred (f49bb34, fc2cf50), the windows lifting off their 2D tiles into
# the room and back (72fdd43), portals as lit doors with a plate, gone
# through into the game's cover and a starting panel fed by the program
# the portal started (21cd50b, 75a6714); and windows("reset"/"undo"), the
# room's state for its menu, the menu and Super+F used from the start
# (c20ebc2, d160a33, 2a0fc09, 03babe6, 18e9916). The labels and panels
# are drawn with Cairo and Pango. Jolt's debug asserts stay out of this
# build (CMAKE_BUILD_TYPE=None set no NDEBUG, so every earlier package had
# them, each an int3): one trapped Hyprland while walking (91cbab6).
# Super + right drag resizes from a corner with the new size drawn in the
# room and the app asked once on release, and the bin catches a carried
# window by where the crosshair points (5617153). A game fullscreen before
# a visit to the room is fullscreen again after it (205fe59), and a window
# hidden by its app while the room is open no longer crashes Hyprland as the
# room is left (db07af5). Snapshots live in textures of their own size,
# mipmapped there, so walking keeps the monitor's frame rate (632a523).
# Larch carries the plugin alone: the one .so and the
# licences of what is compiled into it. No scene, no player model, no
# panorama -- the upstream tree ships none either; the room is the plugin's
# built-in 40x40 grid floor until somebody points the config at a .glb.
# The screenshots, Jolt's sample assets and documentation in the source
# archive stay out.
#
# Built against the installed Hyprland's headers. The plugin compares
# Hyprland's build hash with its own in PLUGIN_INIT and refuses to load on a
# mismatch; larch-3d puts that refusal on screen. Not pinned to one hyprland
# version in depends: [larch] does not build Hyprland, so a pin would stop
# every -Syu from the day Arch moves Hyprland until this is rebuilt.

pkgname=hypr3d
_commit=632a5230ef8d11ac2c7f6646aa9354656339b197
pkgver=0.5.0.r124.g632a523
pkgrel=1
pkgdesc='Hyprland plugin: the session as a walkable 3D room'
arch=(x86_64)
url='https://github.com/samine825/Hypr3D'
license=(MIT)
depends=(hyprland
         hyprgraphics
         cairo
         pango
         libdrm
         libjpeg-turbo
         libglvnd
         libxkbcommon
         pixman
         libgcc
         libstdc++
         glibc)
makedepends=(cmake
             pkgconf)
_fork=https://github.com/AfrobamaYT/Hypr3D
source=("$pkgname-$_commit.tar.gz::$_fork/archive/$_commit.tar.gz")
sha256sums=('77e6b5312925cdd3ac530b4c871d85b3b3bcef6eabf7a09da953a17c62c935da')

build() {
	cd "Hypr3D-$_commit"
	cmake -S . -B build \
		-D CMAKE_BUILD_TYPE=None \
		-D HYPRLAND_HEADERS=/usr
	cmake --build build
}

package() {
	cd "Hypr3D-$_commit"
	install -Dm0755 build/hypr3d.so "$pkgdir/usr/lib/hyprland/hypr3d.so"
	install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm0644 third_party/Jolt/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE.Jolt"
}
