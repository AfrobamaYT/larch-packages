# qt6-m3shapes-git
#
# Pinned to 8a6fe89 (r50), not the AUR's r38.6875533: built at r38, the plugin
# found no libm3shapes.so -- it lay beside the plugin under qt6/qml/M3Shapes,
# with no RPATH to it -- and caelestia-shell 2.5.0 did not load ("Cannot load
# library .../libm3shapesplugin.so: libm3shapes.so: cannot open shared object
# file", release VM, 2026-09-29). Upstream fixed the install in 8a39c10;
# caelestia-shell 2.5.0 was released on r50, which the owner's PC runs.

# Maintainer: Soramane <soramane32 at gmail dot com>

_pkgname='qt6-m3shapes'
pkgname="$_pkgname-git"
pkgver=r50.8a6fe89
pkgrel=1
pkgdesc='A Qt6 library for Material 3 Expressive shapes'
arch=('x86_64' 'aarch64')
url='https://github.com/soramanew/m3shapes'
license=('Apache-2.0')
depends=('qt6-base' 'qt6-declarative')
makedepends=('git' 'cmake' 'ninja' 'qt6-shadertools')
provides=($_pkgname)
conflicts=($_pkgname 'caelestia-shell<2.4.0')
source=("$pkgname::git+$url.git#commit=8a6fe8961749887d677700b6508e0c9249968b7e")
sha256sums=('SKIP')

pkgver() {
    cd "${srcdir}/${pkgname}"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
    cd "${srcdir}/${pkgname}"

    cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=RelWithDebInfo -DCMAKE_INSTALL_PREFIX=/
    cmake --build build
}

package() {
    cd "${srcdir}/${pkgname}"

    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$_pkgname/LICENSE
}
