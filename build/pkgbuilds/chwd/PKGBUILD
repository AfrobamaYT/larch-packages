# Larch: CachyOS's hardware detection, with Larch's own driver profiles.
# Adapted from CachyOS-PKGBUILDS/chwd/PKGBUILD (GPL-3.0-or-later):
# Maintainer: Vladislav Nepogodin <nepogodin.vlad@gmail.com>
# Contributor: Vasiliy Stelmachenok <ventureo@yandex.ru>
#
# Built exactly as upstream. Two changes: the source is pinned to the commit
# the signed tag names (a signed tag would need the author's key in the clean
# build's keyring), and the graphics profiles are Larch's (graphic-drivers.toml
# next to this file): CachyOS's name packages only its own repositories carry.
# Its other profile families (handhelds, T2 Macs, fingerprint readers, ...)
# are not shipped until each is checked against Arch's packages.
# chwd-kernel, CachyOS's kernel helper, is not built: it links against
# alpm_pkg_get_installed_db, which Arch's libalpm (pacman 7.1) does not export
# -- measured, "undefined symbol" at link time. chwd itself does not use libalpm,
# and Larch's profiles read the kernels from /usr/lib/modules.

pkgname=chwd
pkgver=1.24.1
_commit=e99ec339715f2b5724a1adc100ea55b94e59df5a
pkgrel=1
pkgdesc="CachyOS Hardware Detection Tool, with Larch's driver profiles"
arch=(x86_64)
url="https://github.com/cachyos/chwd"
license=(GPL-3.0-or-later)
depends=('gcc-libs' 'pciutils' 'lua' 'pacman' 'libusb' 'libusb-1.0.so')
makedepends=('git' 'cargo' 'lld' 'clang' 'llvm')
source=("chwd::git+$url.git#commit=${_commit}"
        "graphic-drivers.toml")
sha256sums=('SKIP'
            '0821da25d6c90d9cdda734482686d826bf02db7923bf88e6cc15fcc4e9564196')

prepare() {
  cd "$srcdir/$pkgname"

  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$srcdir/$pkgname"

  # Compile with clang
  export AR=llvm-ar
  export CC=clang
  export CXX=clang++
  export NM=llvm-nm
  export RANLIB=llvm-ranlib

  export RUSTFLAGS="-Cembed-bitcode -C opt-level=3 -Ccodegen-units=1 -Clinker=clang -C link-arg=-flto -Clink-arg=-fuse-ld=/usr/bin/ld.lld"

  cargo build --release --frozen
}

package() {
  cd "$srcdir/$pkgname"

  install -Dm755 "target/release/chwd" "$pkgdir/usr/bin/chwd"
  install -Dm755 scripts/chwd "$pkgdir"/var/lib/chwd/scripts/chwd

  install -Dm644 target/release/build/chwd-*/out/chwd.bash "$pkgdir/usr/share/bash-completion/completions/chwd"
  install -Dm644 target/release/build/chwd-*/out/chwd.fish "$pkgdir/usr/share/fish/vendor_completions.d/chwd.fish"
  install -Dm644 target/release/build/chwd-*/out/_chwd "$pkgdir/usr/share/zsh/site-functions/_chwd"

  install -d -m755 "$pkgdir"/var/lib/chwd/{db,local}/pci

  # install ids
  install -d -m755 "$pkgdir"/var/lib/chwd/ids
  cp -r ids/* "$pkgdir"/var/lib/chwd/ids

  install -Dm644 "$srcdir/graphic-drivers.toml" \
    "$pkgdir"/var/lib/chwd/db/pci/graphic_drivers/profiles.toml
}

# vim:set sw=2 sts=2 et:
